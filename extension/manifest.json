{
  "manifest_version": 3,
  "name": "sysctrlSD - переход в приложение",
  "version": "1.0.1",
  "description": "Открывает заявки clients.denvic.ru сразу в приложении sysctrlSD.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://clients.denvic.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "sysctrlSD",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "redirect.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
